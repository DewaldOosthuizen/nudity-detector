# app_config.json — Complete Configuration Reference
#
# This file is the sole configuration surface for the Nudity Detector application.
# No environment-variable overrides are supported (no python-dotenv or os.environ
# usage exists in this codebase). All runtime settings live in config/app_config.json.
#
# Every key below is listed with its default value, the corresponding constant in
# src/core/constants.py that backs that default in code, and whether it is
# Helloz-NSFW-specific or app-wide.
#
# Legend:
#   [app-wide]         Key applies to the whole application (all backends).
#   [Helloz-NSFW]     Key is specific to the Helloz NSFW remote detection backend.
#
# Keys without a constants.py counterpart are marked "no constant" and are read
# directly from app_config.json at runtime.
#
# Timeout units (issue #91): the `_seconds` suffix IS the unit declaration. All
# timeout values are seconds, and no value is ever re-interpreted on the strength of
# its magnitude — "detect_timeout_seconds": 3600 means one hour, as written.
#
# Automatic migration: the config carries a `config_version`. A config without one
# (or below 2) predates the seconds contract and is converted once on startup by
# src/core/config_migration.py, then rewritten with the `_seconds` key names and
# `config_version: 2`:
#   * a legacy millisecond value >= 1000 converts ms -> s, round-half-up (2500 -> 3);
#   * a legacy value below one second — including the shipped `250` — becomes the
#     code default (5 s / 60 s). The whole 0-999 ms band is treated this way: 250 ms
#     is 0.25 s and 700 ms is 0.7 s, neither expressible as a usable whole-second
#     timeout, and rounding either up to 1 s would time out on essentially every file.
#   * a key that ALREADY carries the `_seconds` name wins: the legacy key is
#     dropped and the explicit seconds value is kept, never overwritten.
#   * the two keys that already held seconds but lacked the suffix
#     (`helloz_nsfw_request_timeout`, `helloz_nsfw_health_check_timeout`) are
#     renamed, with their values left untouched. The two dead
#     `*_worker_thread_timeout` keys are NOT renamed — nothing reads them (see
#     DEAD_CONFIG_KEYS), so there is no value whose unit needs restating; issue
#     #104 deletes them.
# The migrated file is written back at startup (atomically, via a temp file and
# os.replace, preserving the existing file's permissions), so the conversion is
# recorded on disk once and never depends on you
# changing a setting. Every rewrite — and every failure to read or rewrite the
# file — is logged at WARNING and shown in the on-screen activity log, naming the
# key and both values. Re-check your timeouts once after upgrading.
#
# NOTE: config/app_config.json is NOT tracked in git (it holds mutable user state
# such as theme/model/last_source_folder). The defaults below are mirrored in
# tests/fixtures/app_config.default.json.
#
# Keys marked "not read by any code" below are dead entries retained as reference
# only; their removal is tracked in issue #104. They are still preserved on save:
# _save_config overwrites only the keys the GUI has a widget for, so any other key
# in your own config/app_config.json — including helloz_nsfw_scheme, which is not
# shipped with a default and not listed below — survives a save.

{
  "config_version": 2,
  # [app-wide]  Schema version of this config. Bumped when the MEANING of a key
  # changes, so the app can migrate existing files exactly once.
  # Backed by: CONFIG_VERSION in src/core/constants.py. Do not hand-edit.

  "theme": "dark",
  # [app-wide]  GUI theme: "system", "light", or "dark".
  # Backed by: THEME_DARK in src/core/constants.py.

  "model": "helloz_nsfw",
  # [app-wide]  Default detection model: "nudenet" or "helloz_nsfw".
  # No constants.py counterpart — used directly from config.

  "threshold_percent": 60.0,
  # [app-wide]  Nudity detection threshold (0.0–100.0).
  # Backed by: DEFAULT_THRESHOLD_PERCENT in src/core/constants.py.

  "last_source_folder": "",
  # [app-wide]  Default source folder opened in the GUI.
  # No constants.py counterpart — used directly from config.

  "progress_update_interval": 100,
  # [app-wide]  Flush UI results every N files processed.
  # Backed by: SCAN_PROGRESS_UPDATE_INTERVAL (100) in src/core/constants.py.

  "video_frame_rate": 5,
  # [app-wide]  Extract every Nth frame when scanning videos.
  # Backed by: VIDEO_FRAME_RATE (5) in src/core/constants.py.
  # The shipped default matches the constant; a configured value that diverges
  # from the constant is honoured but reported at startup.

  "worker_thread_count": 10,
  # [app-wide]  General worker thread pool size.
  # Backed by: WORKER_THREAD_COUNT (10) in src/core/constants.py.

  "worker_thread_timeout_seconds": 5,
  # [app-wide]  General worker thread join timeout, in SECONDS.
  # Backed by: WORKER_THREAD_TIMEOUT (5) in src/core/constants.py.
  # Migrated automatically from the legacy `worker_thread_timeout` (ms) key.

  "nudenet_worker_thread_count": 4,
  # [app-wide]  NudeNet-specific worker thread count.
  # No constants.py counterpart — and NOT read by any code; retained as a
  # reference entry only. Removal is tracked in issue #104.
  # Listed in DEAD_CONFIG_KEYS in src/core/constants.py.

  "nudenet_worker_thread_timeout_seconds": 10,
  # [app-wide]  NudeNet-specific worker thread timeout (s).
  # Not read by any code — retained as a reference entry only; removal is
  # tracked in issue #104 (out of scope for issue #91).

  "helloz_nsfw_worker_thread_count": 20,
  # [Helloz-NSFW]  Helloz NSFW worker thread count.
  # No constants.py counterpart — and NOT read by any code; retained as a
  # reference entry only. Removal is tracked in issue #104.
  # Listed in DEAD_CONFIG_KEYS in src/core/constants.py.

  "helloz_nsfw_worker_thread_timeout_seconds": 35,
  # [Helloz-NSFW]  Helloz NSFW worker thread timeout (s).
  # Not read by any code — retained as a reference entry only; removal is
  # tracked in issue #104 (out of scope for issue #91).

  "detect_timeout_seconds": 60,
  # [app-wide]  Timeout for individual detection calls, in SECONDS.
  # Backed by: DETECT_TIMEOUT (60) in src/core/constants.py.
  # Migrated automatically from the legacy `detect_timeout` (ms) key.

  "helloz_nsfw_host": "localhost",
  # [Helloz-NSFW]  Helloz NSFW server hostname.
  # Backed by: HELLOZ_NSFW_HOST in src/core/constants.py.

  "helloz_nsfw_port": 6086,
  # [Helloz-NSFW]  Helloz NSFW server port.
  # Backed by: HELLOZ_NSFW_PORT in src/core/constants.py.

  "helloz_nsfw_api_endpoint": "/api/upload_check",
  # [Helloz-NSFW]  Helloz NSFW upload-check API path.
  # Backed by: HELLOZ_NSFW_API_ENDPOINT in src/core/constants.py.

  "helloz_nsfw_request_timeout_seconds": 30,
  # [Helloz-NSFW]  HTTP request timeout for Helloz NSFW, in SECONDS.
  # Backed by: HELLOZ_NSFW_REQUEST_TIMEOUT (30) in src/core/constants.py.
  # Renamed automatically from the legacy `helloz_nsfw_request_timeout` key; the
  # value already held seconds and was not converted.
  # The shipped default matches the constant; a configured value that diverges
  # from the constant is honoured but reported at startup.

  "helloz_nsfw_health_check_timeout_seconds": 5
  # [Helloz-NSFW]  Health-check timeout for Helloz NSFW, in SECONDS.
  # Backed by: HELLOZ_NSFW_HEALTH_CHECK_TIMEOUT (5) in src/core/constants.py.
  # Renamed automatically from the legacy `helloz_nsfw_health_check_timeout` key.
}
